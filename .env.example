# =============================================================================
# Site24x7 Code-Mode MCP — Configuration
# =============================================================================
# Single-user mode: set the credentials below. The server reads them on startup
# and uses them for every request.
#
# Multi-user mode: leave the credentials below empty (or unset) and run with
# MCP_TRANSPORT=http. The MCP client must then send credentials in HTTP headers
# on each request:
#   X-Site24x7-Client-Id, X-Site24x7-Client-Secret, X-Site24x7-Refresh-Token,
#   X-Site24x7-Zone, X-Site24x7-Zaaid (optional), X-Site24x7-Account-Type (optional)
#
# Sandbox surface (single flat namespace):
#   - site24x7.<tag>.<op>(args)              typed operationId call
#   - site24x7.callOperation('opId', args)   flat lookup
#   - site24x7.request({ method, path, ... }) raw HTTP escape hatch
#   - site24x7.listCustomers()               MSP/BU customer enumeration
#   - site24x7.withCustomer(zaaid, fn)       run a closure scoped to a customer
#   - site24x7.zaaid                         currently active customer (or null)
#
# See docs/multi-tenant.md, docs/usage.md, and docs/security.md for details.
# =============================================================================

# ─── Transport ────────────────────────────────────────────────────────────
# stdio (default, single-user) | http (Streamable HTTP — required for multi-user)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8000
# Comma-separated allowlist for HTTP transport (default: localhost only).
# Set to "*" to allow any origin (NOT recommended for production).
MCP_HTTP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Zoho OAuth 2.0 (Self Client refresh-token flow) ──────────────────────
# Step-by-step setup is in README.md → "Authentication".
#   1. https://api-console.zoho.com → Add Client → Self Client.
#   2. Note Client ID + Client Secret here.
#   3. Generate Code tab → scopes (comma-separated, e.g.
#        Site24x7.Admin.All,Site24x7.Account.Read,Site24x7.Msp.All,Site24x7.Bu.All)
#        → 10-minute validity → Create.
#   4. Exchange the grant code for a refresh token (curl example in README).
#      The refresh token is PERMANENT — store it here.
#   5. Set SITE24X7_ZONE to the Site24x7 data center your account lives in.
SITE24X7_CLIENT_ID=
SITE24X7_CLIENT_SECRET=
SITE24X7_REFRESH_TOKEN=

# Site24x7 data center / zone. Must match the zone of the Zoho account that
# issued the refresh token. Valid values:
#   com      United States       (default)
#   eu       Europe
#   in       India
#   com.au   Australia
#   cn       China
#   jp       Japan
#   ca       Canada
#   uk       United Kingdom
#   ae       United Arab Emirates
#   sa       Saudi Arabia
SITE24X7_ZONE=com

# ─── MSP / Business Unit scoping (optional, but read this if you're MSP) ──
# Site24x7 has two axes of tenancy: the OAuth identity above, and the
# customer / BU the request acts on. Pass the customer's `zaaid` here as a
# default, or set it per-request via X-Site24x7-Zaaid / site24x7.withCustomer().
#
# Enumerate available customers:    GET /api/short/msp/customers
#                                   GET /api/short/bu/business_units
SITE24X7_ZAAID=

# Optional: clarifies error messages when an MSP/BU-only endpoint is called
# without a zaaid. Values: standard | msp | bu (default: standard).
SITE24X7_ACCOUNT_TYPE=standard

# ─── Sandbox Limits ───────────────────────────────────────────────────────
# Maximum API calls per execute() invocation. Bump for big MSP sweeps;
# remember Site24x7's per-token rate limits (~10 req/s on most plans).
SITE24X7_MAX_CALLS_PER_EXECUTE=50

# Wall-clock deadline for execute() invocations in milliseconds. Default 30s.
SITE24X7_EXECUTE_TIMEOUT_MS=30000

# ─── Spec & Token Cache ───────────────────────────────────────────────────
# Where to cache loaded spec metadata and access-token entries on disk.
# Default: ~/.cache/site24x7-code-mode-mcp/
SITE24X7_CACHE_DIR=
