{
  "name": "site24x7-code-mode-mcp",
  "version": "0.1.0-beta.1",
  "description": "Code-mode MCP server for Zoho Site24x7. Two tools (search + execute) with QuickJS WASM sandbox plus an optional Cloudflare Workers entry. Zoho OAuth 2.0 (Self Client refresh token) with first-class MSP / Business Unit multi-tenant scoping via zaaid. Single-user (env) and multi-user (per-request HTTP headers) modes.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "site24x7-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SKILL.md",
    "examples/",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/spec',{recursive:true});if(fs.existsSync('src/spec/site24x7-fallback.json'))fs.copyFileSync('src/spec/site24x7-fallback.json','dist/spec/site24x7-fallback.json');\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/ scripts/ cf-worker/ --ext .ts",
    "lint:fix": "eslint src/ scripts/ cf-worker/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"cf-worker/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"cf-worker/**/*.ts\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "update-spec": "tsx scripts/update-spec.ts",
    "live-test": "tsx scripts/live-test.ts",
    "smoke:inspector": "bash scripts/smoke-inspector.sh",
    "cf:dev": "wrangler dev --config cf-worker/wrangler.toml",
    "cf:deploy": "wrangler deploy --config cf-worker/wrangler.toml",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run smoke:mcp",
    "smoke:mcp": "node scripts/smoke-mcp.mjs site24x7_search site24x7_execute",
    "cf:check": "wrangler deploy --dry-run --outdir=.wrangler-out --config cf-worker/wrangler.toml"
  },
  "keywords": [
    "site24x7",
    "zoho",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "monitoring",
    "msp",
    "oauth2"
  ],
  "author": "Jamie van der Pijll <jmpijll@users.noreply.github.com> (https://github.com/jmpijll)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmpijll/site24x7-code-mode-mcp.git"
  },
  "homepage": "https://github.com/jmpijll/site24x7-code-mode-mcp#readme",
  "bugs": {
    "url": "https://github.com/jmpijll/site24x7-code-mode-mcp/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6",
    "wrangler": "4.105.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^7.0.0",
    "zod": "^3.23.0"
  }
}
